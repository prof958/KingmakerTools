// KingdomTools — Prisma Schema
// PF2e Kingmaker Campaign Helper

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ──────────────────────────────────────────────
// Phase 0 — Core
// ──────────────────────────────────────────────

model Campaign {
  id            String   @id @default(cuid())
  name          String
  golarionDay   Int      @default(1) @map("golarion_day")
  golarionMonth Int      @default(3) @map("golarion_month")
  golarionYear  Int      @default(4710) @map("golarion_year")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  characters           Character[]
  inventoryItems       InventoryItem[]
  wallets              Wallet[]
  objectives           Objective[]
  quickLinks           QuickLink[]
  campsiteLayouts      CampsiteLayout[]
  recipes              Recipe[]
  wishListItems        WishListItem[]
  bulkCarriers         BulkCarrier[]
  customCampActivities CustomCampActivity[]

  // Phase 5
  kingdom Kingdom?

  @@map("campaigns")
}

model Character {
  id          String   @id @default(cuid())
  campaignId  String   @map("campaign_id")
  name        String
  emoji       String?
  imageUrl    String?  @map("image_url")
  strModifier Int      @default(0) @map("str_modifier")
  isCompanion Boolean  @default(false) @map("is_companion")
  miscBulk    Float    @default(0) @map("misc_bulk")
  createdAt   DateTime @default(now()) @map("created_at")

  campaign          Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  inventoryItems    InventoryItem[]
  wallets           Wallet[]
  campingActivities CampingActivity[]
  wishListItems     WishListItem[]
  bulkCarriers      BulkCarrier[]

  // Phase 5
  leadershipRoles LeadershipRole[]

  @@map("characters")
}

// ──────────────────────────────────────────────
// Phase 1 — Inventory
// ──────────────────────────────────────────────

model Item {
  id                     String       @id @default(cuid())
  name                   String
  bulkValue              Float        @default(0) @map("bulk_value") // numeric bulk (1, 2, etc.)
  isBulkLight            Boolean      @default(false) @map("is_bulk_light") // "L" bulk item
  level                  Int          @default(0)
  rarity                 Rarity       @default(COMMON)
  traits                 String[]     @default([])
  category               ItemCategory @default(GEAR)
  valueCp                Int          @default(0) @map("value_cp") // price in copper pieces
  isInvestable           Boolean      @default(false) @map("is_investable")
  containerCapacity      Float?       @map("container_capacity") // max bulk the container can hold
  containerBulkReduction Float?       @map("container_bulk_reduction") // bulk reduction when worn
  description            String?
  createdAt              DateTime     @default(now()) @map("created_at")

  inventoryItems InventoryItem[]
  wishListItems  WishListItem[]

  @@map("items")
}

model InventoryItem {
  id                       String   @id @default(cuid())
  campaignId               String   @map("campaign_id")
  itemId                   String   @map("item_id")
  characterId              String?  @map("character_id") // null = shared party loot
  containerInventoryItemId String?  @map("container_inventory_item_id") // self-ref: item inside container
  bulkCarrierId            String?  @map("bulk_carrier_id") // item on a mount/vehicle/storage
  quantity                 Int      @default(1)
  isInvested               Boolean  @default(false) @map("is_invested")
  isWorn                   Boolean  @default(false) @map("is_worn")
  notes                    String?
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  campaign    Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  item        Item         @relation(fields: [itemId], references: [id])
  character   Character?   @relation(fields: [characterId], references: [id], onDelete: SetNull)
  bulkCarrier BulkCarrier? @relation(fields: [bulkCarrierId], references: [id], onDelete: SetNull)

  // Self-referencing container relationship
  container      InventoryItem?  @relation("ContainerContents", fields: [containerInventoryItemId], references: [id], onDelete: SetNull)
  containedItems InventoryItem[] @relation("ContainerContents")

  @@map("inventory_items")
}

model Wallet {
  id          String  @id @default(cuid())
  campaignId  String  @map("campaign_id")
  characterId String? @map("character_id") // null = party treasury
  cp          Int     @default(0)
  sp          Int     @default(0)
  gp          Int     @default(0)
  pp          Int     @default(0)

  campaign  Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  character Character? @relation(fields: [characterId], references: [id], onDelete: SetNull)

  @@unique([campaignId, characterId])
  @@map("wallets")
}

model WishListItem {
  id            String   @id @default(cuid())
  campaignId    String   @map("campaign_id")
  characterId   String?  @map("character_id") // null = group wish
  itemId        String?  @map("item_id") // null = custom item
  customName    String?  @map("custom_name")
  customPriceCp Int?     @map("custom_price_cp")
  notes         String?
  isAcquired    Boolean  @default(false) @map("is_acquired")
  createdAt     DateTime @default(now()) @map("created_at")

  campaign  Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  character Character? @relation(fields: [characterId], references: [id], onDelete: SetNull)
  item      Item?      @relation(fields: [itemId], references: [id])

  @@map("wish_list_items")
}

model BulkCarrier {
  id                  String          @id @default(cuid())
  campaignId          String          @map("campaign_id")
  name                String
  type                BulkCarrierType
  bulkCapacity        Float           @map("bulk_capacity")
  notes               String?
  assignedCharacterId String?         @map("assigned_character_id")
  createdAt           DateTime        @default(now()) @map("created_at")

  campaign          Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  assignedCharacter Character?      @relation(fields: [assignedCharacterId], references: [id], onDelete: SetNull)
  inventoryItems    InventoryItem[]

  @@map("bulk_carriers")
}

// ──────────────────────────────────────────────
// Phase 2 — Dashboard
// ──────────────────────────────────────────────

model Objective {
  id          String          @id @default(cuid())
  campaignId  String          @map("campaign_id")
  title       String
  description String?
  status      ObjectiveStatus @default(ACTIVE)
  priority    Int             @default(0)
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@map("objectives")
}

model QuickLink {
  id         String  @id @default(cuid())
  campaignId String  @map("campaign_id")
  label      String
  url        String
  category   String?
  sortOrder  Int     @default(0) @map("sort_order")

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@map("quick_links")
}

// ──────────────────────────────────────────────
// Phase 3 — Campsite
// ──────────────────────────────────────────────

model CampsiteLayout {
  id         String   @id @default(cuid())
  campaignId String   @map("campaign_id")
  name       String
  isActive   Boolean  @default(false) @map("is_active")
  elements   Json     @default("[]") // JSONB: positions of tents, fire, PCs, traps
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  campaign          Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  watchShifts       WatchShift[]
  campingActivities CampingActivity[]

  @@map("campsite_layouts")
}

model WatchShift {
  id               String   @id @default(cuid())
  campsiteLayoutId String   @map("campsite_layout_id")
  shiftNumber      Int      @map("shift_number")
  characterIds     String[] @map("character_ids") // array of character IDs on this shift

  campsiteLayout CampsiteLayout @relation(fields: [campsiteLayoutId], references: [id], onDelete: Cascade)

  @@unique([campsiteLayoutId, shiftNumber])
  @@map("watch_shifts")
}

model CampingActivity {
  id               String  @id @default(cuid())
  campsiteLayoutId String  @map("campsite_layout_id")
  characterId      String  @map("character_id")
  activityType     String  @map("activity_type")
  skill            String?
  result           String? // "critical_success" | "success" | "failure" | "critical_failure"

  campsiteLayout CampsiteLayout @relation(fields: [campsiteLayoutId], references: [id], onDelete: Cascade)
  character      Character      @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@map("camping_activities")
}

model Recipe {
  id                 String   @id @default(cuid())
  campaignId         String   @map("campaign_id")
  name               String
  ingredients        String?
  dc                 Int?
  dcSurvival         Int?     @map("dc_survival")
  dcCookingLore      Int?     @map("dc_cooking_lore")
  effectsCritSuccess String?  @map("effects_crit_success")
  effectsSuccess     String?  @map("effects_success")
  effectsFail        String?  @map("effects_fail")
  effectsCritFail    String?  @map("effects_crit_fail")
  isDiscovered       Boolean  @default(false) @map("is_discovered")
  createdAt          DateTime @default(now()) @map("created_at")

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@map("recipes")
}

model CustomCampActivity {
  id          String   @id @default(cuid())
  campaignId  String   @map("campaign_id")
  name        String
  description String?
  skill       String?
  createdAt   DateTime @default(now()) @map("created_at")

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@map("custom_camp_activities")
}

// ──────────────────────────────────────────────
// Phase 5 — Kingdom Management
// ──────────────────────────────────────────────

model Kingdom {
  id         String         @id @default(cuid())
  campaignId String         @unique @map("campaign_id")
  name       String         @default("Unnamed Kingdom")
  ruleset    KingdomRuleset @default(VK)

  // Progression — levelling is by milestone, so no XP is tracked
  level    Int      @default(1)
  size     Int      @default(1) // total hexes; drives the Size table
  fame     Int      @default(1)
  fameType FameType @default(FAME)
  fameMax  Int      @default(3) @map("fame_max")
  atWar    Boolean  @default(false) @map("at_war")

  // Founding choices (Kingdom Creation steps 2-5)
  charter             String?
  charterFreeBoost    String?  @map("charter_free_boost")
  heartland           String?
  government          String?
  governmentFreeBoost String?  @map("government_free_boost")
  finalizeBoosts      String[] @default([]) @map("finalize_boosts")
  /// Free trained-skill picks. The skills the founding choices grant outright
  /// are derived from them; only the player's own picks need storing.
  skillPicks          String[] @default([]) @map("skill_picks")
  /// False until the founding wizard is completed, which is what decides
  /// whether the Kingdom tab shows onboarding or the dashboard.
  founded             Boolean  @default(false)

  // Ability scores
  culture   Int @default(10)
  economy   Int @default(10)
  loyalty   Int @default(10)
  stability Int @default(10)

  // Unrest
  unrest Int @default(0)

  // Ruin — points / threshold / penalty per category
  corruptionPoints    Int @default(0) @map("corruption_points")
  corruptionThreshold Int @default(10) @map("corruption_threshold")
  corruptionPenalty   Int @default(0) @map("corruption_penalty")
  crimePoints         Int @default(0) @map("crime_points")
  crimeThreshold      Int @default(10) @map("crime_threshold")
  crimePenalty        Int @default(0) @map("crime_penalty")
  decayPoints         Int @default(0) @map("decay_points")
  decayThreshold      Int @default(10) @map("decay_threshold")
  decayPenalty        Int @default(0) @map("decay_penalty")
  strifePoints        Int @default(0) @map("strife_points")
  strifeThreshold     Int @default(10) @map("strife_threshold")
  strifePenalty       Int @default(0) @map("strife_penalty")

  // Resources
  rp                Int @default(0) // resource points, rolled each turn
  resourceDiceBonus Int @default(0) @map("resource_dice_bonus") // carryover bonus/penalty dice
  food              Int @default(0)
  lumber            Int @default(0)
  luxuries          Int @default(0)
  ore               Int @default(0)
  stone             Int @default(0)

  // Turn tracking
  currentTurn Int @default(0) @map("current_turn")

  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  campaign        Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  skills          KingdomSkill[]
  feats           KingdomFeat[]
  leadershipRoles LeadershipRole[]
  hexes           Hex[]
  settlements     Settlement[]
  turns           KingdomTurn[]

  @@map("kingdoms")
}

model KingdomSkill {
  id        String @id @default(cuid())
  kingdomId String @map("kingdom_id")
  skill     String // one of the 16 kingdom skills
  rank      Int    @default(0) // 0 untrained .. 4 legendary

  kingdom Kingdom @relation(fields: [kingdomId], references: [id], onDelete: Cascade)

  @@unique([kingdomId, skill])
  @@map("kingdom_skills")
}

model KingdomFeat {
  id           String   @id @default(cuid())
  kingdomId    String   @map("kingdom_id")
  name         String
  takenAtLevel Int?     @map("taken_at_level")
  isBonus      Boolean  @default(false) @map("is_bonus") // granted by government
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at")

  kingdom Kingdom @relation(fields: [kingdomId], references: [id], onDelete: Cascade)

  @@map("kingdom_feats")
}

model LeadershipRole {
  id          String  @id @default(cuid())
  kingdomId   String  @map("kingdom_id")
  role        String // ruler, counselor, general, emissary, magister, treasurer, viceroy, warden
  characterId String? @map("character_id")
  npcName     String? @map("npc_name") // role held by an NPC instead of a party character
  invested    Boolean @default(false)

  kingdom   Kingdom    @relation(fields: [kingdomId], references: [id], onDelete: Cascade)
  character Character? @relation(fields: [characterId], references: [id], onDelete: SetNull)

  @@unique([kingdomId, role])
  @@map("leadership_roles")
}

model Hex {
  id            String   @id @default(cuid())
  kingdomId     String   @map("kingdom_id")
  /// Which Stolen Lands map sheet (1-4) this hex belongs to. The four sheets
  /// are separate maps, so coordinates are only unique within one.
  sheet         Int      @default(1)
  q             Int // axial coordinate
  r             Int // axial coordinate
  terrain       String   @default("plains")
  state         HexState @default(UNCLAIMED)
  reconnoitered Boolean  @default(false)
  hasRoads      Boolean  @default(false) @map("has_roads")
  fortified     Boolean  @default(false)
  workSite      String?  @map("work_site") // farmland, lumber, mine, quarry
  features      String[] @default([]) // landmark, refuge, resource, bridge, ruins, freehold
  label         String?
  notes         String?

  kingdom    Kingdom     @relation(fields: [kingdomId], references: [id], onDelete: Cascade)
  settlement Settlement?

  @@unique([kingdomId, sheet, q, r])
  @@map("hexes")
}

model Settlement {
  id          String         @id @default(cuid())
  kingdomId   String         @map("kingdom_id")
  hexId       String?        @unique @map("hex_id")
  name        String
  type        SettlementType @default(VILLAGE)
  isCapital   Boolean        @default(false) @map("is_capital")
  level       Int            @default(1)
  overcrowded Boolean        @default(false)
  grid        Json           @default("{}") // JSONB urban grid: blocks, lots, structures, borders
  notes       String?
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  kingdom Kingdom @relation(fields: [kingdomId], references: [id], onDelete: Cascade)
  hex     Hex?    @relation(fields: [hexId], references: [id], onDelete: SetNull)

  @@map("settlements")
}

model KingdomStructure {
  id           String   @id @default(cuid())
  name         String
  level        Int      @default(1)
  lots         Int      @default(1)
  costRp       Int      @default(0) @map("cost_rp")
  costLumber   Int      @default(0) @map("cost_lumber")
  costLuxuries Int      @default(0) @map("cost_luxuries")
  costOre      Int      @default(0) @map("cost_ore")
  costStone    Int      @default(0) @map("cost_stone")
  itemBonus    Int?     @map("item_bonus")
  itemBonusTo  String?  @map("item_bonus_to") // activity the item bonus applies to
  traits       String[] @default([])
  effects      String?
  description  String?
  isVkAddition Boolean  @default(false) @map("is_vk_addition") // added by the V&K house rules

  @@map("kingdom_structures")
}

model KingdomTurn {
  id         String   @id @default(cuid())
  kingdomId  String   @map("kingdom_id")
  turnNumber Int      @map("turn_number")
  status     String   @default("in_progress") // in_progress, complete
  phaseData  Json     @default("{}") @map("phase_data") // per-step state + activity log
  rpRolled   Int?     @map("rp_rolled")
  summary    String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  kingdom Kingdom @relation(fields: [kingdomId], references: [id], onDelete: Cascade)

  @@unique([kingdomId, turnNumber])
  @@map("kingdom_turns")
}

// ──────────────────────────────────────────────
// Enums
// ──────────────────────────────────────────────

enum Rarity {
  COMMON
  UNCOMMON
  RARE
  UNIQUE
}

enum ItemCategory {
  WEAPON
  ARMOR
  SHIELD
  GEAR
  CONSUMABLE
  WORN
  HELD
  MATERIAL
  CONTAINER
  WAND
  OTHER
}

enum ObjectiveStatus {
  ACTIVE
  COMPLETED
  FAILED
  ARCHIVED
}

enum KingdomRuleset {
  RAW
  VK
}

enum FameType {
  FAME
  INFAMY
}

enum HexState {
  UNCLAIMED
  RECONNOITERED
  CLAIMED
}

enum SettlementType {
  VILLAGE
  TOWN
  CITY
  METROPOLIS
}

enum BulkCarrierType {
  MOUNT
  PACK_ANIMAL
  VEHICLE
  MAGICAL_STORAGE
  CUSTOM
}
