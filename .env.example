# Copy this file to .env for local development:
#   cp .env.example .env
#
# .env is git-ignored on purpose — never commit it, and never paste production
# values into it. The production DATABASE_URL / APP_PASSWORD_HASH / SESSION_SECRET
# live only in the VPS's environment (see docs/DEPLOY.md); nothing here can reach
# or affect that database. `npm run db:up` starts a local-only Postgres container
# (docker-compose.dev.yml) with its own named Docker volume, separate from the
# prod compose file and the prod data directory.

# ── PostgreSQL (local dev container started by `npm run db:up`) ──
DATABASE_URL="postgresql://kingdomtools:localdev@localhost:5432/kingdomtools"
POSTGRES_USER="kingdomtools"
POSTGRES_PASSWORD="localdev"

# ── Auth ──
# APP_PASSWORD_HASH can be omitted entirely for local dev: auth.ts falls back
# to a hardcoded hash for the password "kingmaker" when this is unset. Only
# set a real value here if you want to test the login page with a different
# password; generate one with:
#   node -e "console.log(require('bcryptjs').hashSync('yourpassword', 10))"
# APP_PASSWORD_HASH=

# Any string works locally — this only needs to be unpredictable in production.
SESSION_SECRET="dev-only-secret-change-me"

# ── App ──
NEXT_PUBLIC_APP_NAME="KingdomTools (dev)"
